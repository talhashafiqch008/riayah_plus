{
  "expo": {
    "name": "Riayah Plus",
    "slug": "riayah-plus",
    "owner": "benaa-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "raiyahplus",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.raiyahplus.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Riayah Plus uses your location only when you check in or out of a visit, to confirm you are at the patient's address.",
        "NSCameraUsageDescription": "Riayah Plus needs camera access for telehealth video visits.",
        "NSMicrophoneUsageDescription": "Riayah Plus needs microphone access for telehealth visits and voice notes."
      }
    },
    "android": {
      "package": "com.raiyahplus.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0D9488",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Riayah Plus uses your location only when you check in or out of a visit, to confirm you are at the patient's address."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0D9488"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Riayah Plus needs camera access for telehealth video visits.",
          "microphonePermission": "Riayah Plus needs microphone access for telehealth visits and voice notes.",
          "recordAudioAndroid": true
        }
      ],
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF9",
          "dark": {
            "backgroundColor": "#1C1917"
          }
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": true
          }
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "6925979d-a75e-46be-ae05-074b60b5d65e"
      }
    }
  }
}
