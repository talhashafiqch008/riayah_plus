{
  "expo": {
    "name": "Riayah Plus",
    "slug": "raiyah-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "raiyahplus",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.raiyahplus.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Riayah Plus uses your location only when you check in or out of a visit, to confirm you are at the patient's address."
      }
    },
    "android": {
      "package": "com.raiyahplus.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0D9488",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Riayah Plus uses your location only when you check in or out of a visit, to confirm you are at the patient's address."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0D9488"
        }
      ],
      "expo-camera",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF9",
          "dark": {
            "backgroundColor": "#1C1917"
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
