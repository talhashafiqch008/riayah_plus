# Raiyah Client — Vite environment variables
# Copy this file to .env and fill in values.
# All client-side vars MUST use the VITE_ prefix.

VITE_API_URL=/api
# Dev (HTTPS Vite): leave empty so Socket.IO connects to the same origin and
# Vite proxies /socket.io → the API. Do NOT set http://localhost:5001 while the
# SPA is served over https:// — browsers block that as mixed content.
# Production: set to your API origin only if the SPA is on a different host.
VITE_SOCKET_URL=
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_SENTRY_DSN=
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1
VITE_ENABLE_GEMINI_CHAT=true
VITE_APP_VERSION=1.0.0
