# ─── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
ADMIN_SECRET=your-admin-secret-here

# Reverse-proxy IP trust (production / TRUST_PROXY=true). Set to the number of hops that
# append X-Forwarded-For (usually 1). Edge proxy must overwrite client XFF, not append.
# See deploy/nginx-api.conf.example and docx/ops/TRUST_PROXY_TOPOLOGY.md.
# TRUST_PROXY=false
# TRUST_PROXY_HOPS=1

# ─── Database ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/riayah_plus?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
# During zero-downtime rotation only — previous secrets are verify-only:
# JWT_ACCESS_SECRET_PREVIOUS=
# JWT_REFRESH_SECRET_PREVIOUS=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=riayah-plus
JWT_AUDIENCE=riayah-plus-api
BCRYPT_ROUNDS=12

# Break-glass admin login (keep disabled). When enabling, also set ADMIN_BREAK_GLASS_USER_ID.
# ALLOW_ADMIN_SECRET_LOGIN=false
# ADMIN_BREAK_GLASS_USER_ID=

# ─── GDPR data export (AES-256-GCM at rest; optional dedicated key) ───────────
# DATA_EXPORT_ENCRYPTION_KEY=
DATA_EXPORT_TTL_HOURS=24

# ─── AWS ──────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-south-1
AWS_BUCKET=riayah-plus-uploads
AWS_SECRETS_MANAGER_REGION=me-south-1
# PHI at rest (required in production: TELEHEALTH_RECORDING_KMS_KEY + CHAT_ATTACHMENT_KMS_KEY)
AWS_KMS_KEY_ID=alias/aws/s3
TELEHEALTH_RECORDING_KMS_KEY=alias/aws/s3
CHAT_ATTACHMENT_KMS_KEY=alias/aws/s3
INVOICE_PDF_KMS_KEY=alias/aws/s3

# ─── Mail ─────────────────────────────────────────────────────────────
MAIL_HOST=smtp.ses.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@riayahplus.com
MAIL_FROM_NAME="Riayah Plus"

# ─── Stripe ───────────────────────────────────────────────────────────
STRIPE_KEY=pk_test_...
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Qatari Payment Gateway ───────────────────────────────────────────
# PayTabs / Fatora / Skipcash — NAPS-linked (QNB, Doha Bank, CBQ, QIB)
QATAR_PAYMENT_GATEWAY=paytabs
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
# Qatar merchant host (not .sa). Sandbox and live share the same host; keys differ.
PAYTABS_BASE_URL=https://secure-doha.paytabs.com/payment/request
PAYTABS_WEBHOOK_SECRET=

# SkipCash sandbox — https://dev.skipcash.app/doc/api-integration/
# Set QATAR_PAYMENT_GATEWAY=skipcash once adapter is wired (default remains paytabs).
SKIPCASH_CLIENT_ID=
SKIPCASH_KEY_ID=
SKIPCASH_SECRET_KEY=
SKIPCASH_WEBHOOK_KEY=
SKIPCASH_BASE_URL=https://skipcashtest.azurewebsites.net

# ─── Socket.io ────────────────────────────────────────────────────────
# (also supports Pusher for backward compat with existing frontend)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap2
BROADCAST_DRIVER=socket.io

# ─── LiveKit (Telehealth) ─────────────────────────────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud

# ─── Daily.co / Twilio Video (alternative) ───────────────────────────
DAILY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Firebase (FCM push notifications) ───────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

# ─── Google Maps (GPS / Geofencing) ──────────────────────────────────
GOOGLE_MAPS_API_KEY=
GPS_CHECKIN_RADIUS_METERS=200

# ─── WhatsApp (Meta Graph API) ────────────────────────────────────────
WHATSAPP_BASE_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ─── AI Services ──────────────────────────────────────────────────────
GEMINI_API_KEY=
AI_SERVICE_URL=https://ca-riayah-ai-staging.yellowcoast-06b87bcc.uaenorth.azurecontainerapps.io
AI_SERVICE_API_KEY=local-dev-key-12345

# ─── Sentry ───────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ─── Backup ───────────────────────────────────────────────────────────
BACKUP_S3_BUCKET=riayah-plus-backups
BACKUP_RETENTION_DAYS=30
