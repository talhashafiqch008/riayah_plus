generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  super_admin
  support_admin
  care_coordinator
  clinical_staff
  support_worker
  provider
  doctor
  nurse
  physiotherapist
  occupational_therapist
  speech_therapist
  psychologist
  dietitian
  cleaner
  gardener
  driver
  companion
  nanny
  caregiver
  therapist
  trainer
  client
  consumer
  family
  patient
  staff
}

enum OnboardingStatus {
  pending
  in_progress
  complete
}

enum BookingStatus {
  pending
  accepted
  rejected
  cancelled
  in_progress
  completed
  no_show
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  partially_refunded
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
  disputed
  cancelled
}

enum DocumentStatus {
  pending
  approved
  rejected
  expired
}

enum DisputeStatus {
  open
  under_review
  resolved
  escalated
}

enum ShiftStatus {
  active
  on_break
  completed
}

enum CareEpisodeStatus {
  intake_submitted
  under_review
  validated
  active
  on_hold
  closed
}

enum CarePlanStatus {
  draft
  submitted_for_approval
  approved
  active
  revision_requested
  rejected
  completed
}

enum AssessmentStatus {
  scheduled
  completed
  cancelled
}

enum GoalStatus {
  active
  achieved
  paused
  cancelled
}

enum MessageStatus {
  sent
  delivered
  read
}

enum NotificationChannel {
  in_app
  email
  push
  whatsapp
}

enum PayoutStatus {
  pending
  approved
  processing
  completed
  rejected
  cancelled
}

enum CareNeedStatus {
  open
  in_progress
  fulfilled
  closed
}

enum BidStatus {
  pending
  accepted
  rejected
  withdrawn
  counter_offered
}

enum OfferStatus {
  active
  booked
  expired
  withdrawn
}

enum MarketplaceOfferStatus {
  active
  booked
  expired
  withdrawn
}

enum CourseStatus {
  draft
  published
  archived
}

enum EnrollmentStatus {
  enrolled
  completed
  dropped
}

enum SessionType {
  telehealth
  in_person
  home_visit
}

enum UrgencyLevel {
  low
  medium
  high
  urgent
}

enum ServiceCategory {
  speech_therapy
  occupational_therapy
  behavioral_support
  physiotherapy
  nursing
  companion_care
}

// ─────────────────────────────────────────────────────────────────────────────
// Organization & Structure
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  address     String?
  phone       String?
  email       String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinics     Clinic[]
  users       User[]

  @@map("organizations")
}

model Clinic {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  phone          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  departments    Department[]
  users          User[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("clinics")
}

model Department {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]

  @@unique([clinicId, name])
  @@index([clinicId])
  @@map("departments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String           @id @default(cuid())
  organizationId   String?
  organization     Organization?    @relation(fields: [organizationId], references: [id])
  clinicId         String?
  clinic           Clinic?          @relation(fields: [clinicId], references: [id])
  departmentId     String?
  department       Department?      @relation(fields: [departmentId], references: [id])

  name             String
  email            String           @unique
  phone            String?          @unique
  passwordHash     String
  role             UserRole
  avatar           String?
  isEmailVerified  Boolean          @default(false)
  isPhoneVerified  Boolean          @default(false)
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  isActive              Boolean          @default(true)
  processingRestricted  Boolean          @default(false)
  onboardingStatus      OnboardingStatus @default(pending)
  twoFactorSecret  String?
  twoFactorEnabled Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  // Profile sub-data
  providerProfile  ServiceProvider?
  clientProfile    ClientProfile?

  // Relations
  tokens           RefreshToken[]
  authSessions     UserSession[]
  otpVerifications OtpVerification[]
  notifications    Notification[]
  documents        Document[]
  sentMessages     Message[]         @relation("SentMessages")
  receivedMessages Message[]         @relation("ReceivedMessages")
  auditLogs        AuditLog[]
  consentLogs      ConsentLog[]

  // Care relations
  careRecipients     CareRecipient[]
  managedEpisodes    CareEpisode[]    @relation("CoordinatorEpisodes")
  patientEpisodes    CareEpisode[]    @relation("PatientEpisodes")
  carePlans          CarePlan[]
  assessments        Assessment[]     @relation("AssessorAssessments")
  assignedAssessments Assessment[]   @relation("PatientAssessments")
  goals              Goal[]
  providerSessions   Session[]        @relation("ProviderSessions")
  clientSessions     Session[]        @relation("ClientSessions")
  clinicalNotes      ClinicalNote[]
  invoices           Invoice[]        @relation("ClientInvoices")
  payments           Payment[]

  // Provider relations
  bookings           Booking[]        @relation("ClientBookings")
  providerBookings   Booking[]        @relation("ProviderBookings")
  walletBalance      WalletBalance?
  creditTransactions CreditTransaction[]
  creditTopups       CreditTopup[]
  payoutRequests     PayoutRequest[]
  providerOffers     ProviderOffer[]  @relation("ProviderOffers")
  clientOffers       ProviderOffer[]  @relation("ClientOffers")
  marketplaceOffers  ProviderMarketplaceOffer[]
  careNeeds          CareNeed[]
  careNeedBids       CareNeedBid[]
  matchedAs          ProviderMatch[]  @relation("ProviderMatches")
  reviews            Review[]         @relation("ReviewerReviews")
  receivedReviews    Review[]         @relation("ProviderReviews")
  availabilitySlots  ProviderAvailabilitySlot[]
  pricingRules       ProviderPricingRule[]
  pricing            ProviderPricing[]
  shifts             Shift[]          @relation("WorkerShifts")
  assignedTasks      Task[]           @relation("AssignedTasks")
  createdTasks       Task[]           @relation("CreatedTasks")
  managedAssignments StaffAssignment[] @relation("ManagedAssignments")
  reports            ClientReport[]   @relation("ProviderReports")
  clientReports      ClientReport[]   @relation("ClientReports")
  emergencyRequests       EmergencyRequest[]
  documentRequests        DocumentRequest[]
  targetDocumentRequests  DocumentRequest[]          @relation("TargetDocumentRequests")
  conversationLinks       ConversationParticipant[]
  familyMembers      FamilyMember[]   @relation("FamilyMemberManager")
  whatsappMessages   WhatsAppMessage[]
  courseEnrollments  Enrollment[]
  trainerCourses     Course[]
  gpsLogs            GpsLog[]
  deletionReason     String?
  verificationStatus String   @default("pending")

  // Phase 1-6 new relations
  consents              Consent[]
  providerProfileExt    ProviderProfile?
  agencyStaffManaged    AgencyStaff[]
  meetingsAsHost        Meeting[]        @relation("MeetingHost")
  meetingsAsParticipant Meeting[]        @relation("MeetingParticipant")
  lessonProgress        LessonProgress[]
  quizAttempts          QuizAttempt[]
  patientIncidents        Incident[]               @relation("PatientIncidents")
  reportedIncidents       Incident[]               @relation("ReportedIncidents")
  assignedIncidents       Incident[]               @relation("AssignedIncidents")
  resolvedIncidents       Incident[]               @relation("ResolvedIncidents")
  careOrders              CareOrder[]
  raisedDisputes          BookingDispute[]          @relation("RaisedDisputes")
  dataExportRequests      DataExportRequest[]       @relation("DataExportRequests")
  accountDeletionRequests AccountDeletionRequest[]  @relation("AccountDeletionRequests")
  pushTokens              PushNotificationToken[]   @relation("PushTokens")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([organizationId])
  @@index([clinicId])
  @@index([departmentId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique /// HMAC-SHA256 hash of refresh JWT (plain token never stored)
  deviceId  String?
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String?
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("user_sessions")
}

model OtpVerification {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifier String
  otp        String
  type       String    @default("phone")
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier])
  @@map("otp_verifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Provider & Client Profiles
// ─────────────────────────────────────────────────────────────────────────────

// ServiceProvider holds NDIS, verification, and geo fields only.
// Rating, hourlyRate, bio, reviewCount live in ProviderProfile (single source of truth).
model ServiceProvider {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations String[]
  languages       String[]
  isVerified      Boolean  @default(false)
  ndisRegistered  Boolean  @default(false)
  ndisNumber      String?
  location        String?
  latitude        Decimal? @db.Decimal(10, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("service_providers")
}

model ClientProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth         DateTime?
  gender              String?
  address             String?
  city                String?
  country             String    @default("QA")
  postalCode          String?
  language            String    @default("en")
  nationalId          String?
  insuranceProvider   String?
  insuranceNumber     String?
  medicalNotes        String?
  allergies           String[]
  medications         String[]
  emergencyContact    String?
  emergencyName       String?
  emergencyPhone      String?
  preferredCareTypes  String[]
  ndisNumber          String?
  fundingType         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("client_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Care Recipients & Family
// ─────────────────────────────────────────────────────────────────────────────

model CareRecipient {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  dateOfBirth DateTime?
  gender      String?
  relationship String?
  medicalInfo Json?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  careEpisodes CareEpisode[]
  careOrders   CareOrder[]

  @@index([userId])
  @@map("care_recipients")
}

model FamilyMember {
  id                  String   @id @default(cuid())
  managerId           String
  manager             User     @relation("FamilyMemberManager", fields: [managerId], references: [id])
  name                String
  relationship        String?
  email               String?
  phone               String?
  role                String?
  canReceiveUpdates   Boolean  @default(false)
  isEmergencyContact  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("family_members")
}

// ─────────────────────────────────────────────────────────────────────────────
// Care Episodes (Clinical Domain — M2)
// ─────────────────────────────────────────────────────────────────────────────

model CareEpisode {
  id               String            @id @default(cuid())
  coordinatorId    String
  coordinator      User              @relation("CoordinatorEpisodes", fields: [coordinatorId], references: [id])
  patientId        String
  patient          User              @relation("PatientEpisodes", fields: [patientId], references: [id])
  careRecipientId  String?
  careRecipient    CareRecipient?    @relation(fields: [careRecipientId], references: [id])

  title                   String
  status                  CareEpisodeStatus @default(intake_submitted)
  urgencyLevel            UrgencyLevel?
  reasonForCare           String?
  medicalHistory          String?
  currentMeds             String?
  diagnoses               String[]
  serviceInterests        ServiceCategory[]
  observedChallenges      String[]
  developmentalMilestones String?
  priorAssessments        String[]
  consentGiven            Boolean           @default(false)

  intakeSummary    Json?
  intakeReviewedAt DateTime?
  intakeReviewerId String?

  openedAt         DateTime          @default(now())
  closedAt         DateTime?
  summaryPdfUrl    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  assessments      Assessment[]
  carePlans        CarePlan[]
  sessions         Session[]
  documents        Document[]        @relation("EpisodeDocuments")
  invoices         Invoice[]
  clinicalNotes    ClinicalNote[]    @relation("EpisodeClinicalNotes")
  tasks            Task[]            @relation("EpisodeTasks")
  incidents        Incident[]        @relation("EpisodeIncidents")
  aiIntakeSummary  AiIntakeSummary?

  @@index([patientId])
  @@index([coordinatorId])
  @@map("care_episodes")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI Intake Summary
// ─────────────────────────────────────────────────────────────────────────────

model AiIntakeSummary {
  id                         String      @id @default(cuid())
  careEpisodeId              String      @unique
  careEpisode                CareEpisode @relation(fields: [careEpisodeId], references: [id], onDelete: Cascade)
  model                      String
  promptTokens               Int
  completionTokens           Int
  totalTokens                Int
  keyConcerns                String[]
  urgencyIndicators          String[]
  suggestedServiceCategories String[]
  flaggedRiskFactors         Json?
  clinicalImpressions        String?
  confidence                 String?
  status                     String      @default("draft")
  approvedById               String?
  approvedAt                 DateTime?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  @@index([careEpisodeId])
  @@map("ai_intake_summaries")
}

// ─────────────────────────────────────────────────────────────────────────────
// Assessments (M2)
// ─────────────────────────────────────────────────────────────────────────────

model Assessment {
  id           String           @id @default(cuid())
  episodeId    String
  episode      CareEpisode      @relation(fields: [episodeId], references: [id])
  assessorId   String
  assessor     User             @relation("AssessorAssessments", fields: [assessorId], references: [id])
  patientId    String
  patient      User             @relation("PatientAssessments", fields: [patientId], references: [id])

  type         String
  status       AssessmentStatus @default(scheduled)
  scheduledAt  DateTime
  completedAt  DateTime?
  findings     Json?
  recommendations String?
  reportUrl    String?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([episodeId])
  @@map("assessments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Care Plans & Goals (M3)
// ─────────────────────────────────────────────────────────────────────────────

model CarePlan {
  id             String        @id @default(cuid())
  episodeId      String
  episode        CareEpisode   @relation(fields: [episodeId], references: [id])
  coordinatorId  String
  coordinator    User          @relation(fields: [coordinatorId], references: [id])

  version           Int           @default(1)
  status            CarePlanStatus @default(draft)
  title             String
  notes             String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  approvedById      String?
  rejectionNotes    String?
  isCurrentVersion  Boolean        @default(true)
  previousVersionId String?
  previousVersion   CarePlan?      @relation("CarePlanVersions", fields: [previousVersionId], references: [id])
  nextVersions      CarePlan[]     @relation("CarePlanVersions")

  goals          Goal[]
  items          CarePlanItem[]
  approvalLogs   CarePlanApprovalLog[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([episodeId])
  @@map("care_plans")
}

model CarePlanItem {
  id           String   @id @default(cuid())
  carePlanId   String
  carePlan     CarePlan @relation(fields: [carePlanId], references: [id])
  serviceType  String
  frequency    String?
  duration     String?
  unitCost     Decimal? @db.Decimal(10, 2)
  currency     String   @default("QAR")
  assignedRole String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("care_plan_items")
}

model Goal {
  id                String     @id @default(cuid())
  carePlanId        String
  carePlan          CarePlan   @relation(fields: [carePlanId], references: [id])
  userId            String
  user              User       @relation(fields: [userId], references: [id])

  title             String
  description       String?
  tier              String     @default("short_term")
  category          String     @default("functional")
  measurableOutcome String?
  targetDate        DateTime?
  measurement       String?
  status            GoalStatus @default(active)
  notes             String?
  achievedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  tasks             Task[]

  @@index([carePlanId])
  @@map("goals")
}

model CarePlanApprovalLog {
  id         String   @id @default(cuid())
  carePlanId String
  carePlan   CarePlan @relation(fields: [carePlanId], references: [id])
  action     String
  actorId    String
  notes      String?
  createdAt  DateTime @default(now())

  @@map("care_plan_approval_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sessions / Bookings
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id              String      @id @default(cuid())
  episodeId       String?
  episode         CareEpisode? @relation(fields: [episodeId], references: [id])
  providerId      String
  provider        User        @relation("ProviderSessions", fields: [providerId], references: [id])
  clientId        String
  client          User        @relation("ClientSessions", fields: [clientId], references: [id])

  type            SessionType @default(in_person)
  status          BookingStatus @default(pending)
  scheduledAt     DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  durationMinutes Int?
  notes           String?
  recordingUrl    String?
  livekitRoomId   String?
  dailyRoomUrl    String?

  latitude        Decimal?    @db.Decimal(10, 8)
  longitude       Decimal?    @db.Decimal(11, 8)
  checkInAt       DateTime?
  checkOutAt      DateTime?
  checkInLat      Decimal?    @db.Decimal(10, 8)
  checkInLng      Decimal?    @db.Decimal(11, 8)
  checkOutLat     Decimal?    @db.Decimal(10, 8)
  checkOutLng     Decimal?    @db.Decimal(11, 8)
  isGeofenced     Boolean     @default(false)
  geofenceStatus  String?

  clinicalNotes   ClinicalNote[]
  invoice         Invoice?
  payment         Payment?
  gpsLogs         GpsLog[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([providerId])
  @@index([clientId])
  @@index([episodeId])
  @@map("sessions")
}

model ClinicalNote {
  id          String       @id @default(cuid())
  sessionId   String?
  session     Session?     @relation(fields: [sessionId], references: [id])
  episodeId   String?
  episode     CareEpisode? @relation("EpisodeClinicalNotes", fields: [episodeId], references: [id])
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  content     String
  noteType    String       @default("session_note")
  isPrivate   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([episodeId])
  @@index([sessionId])
  @@map("clinical_notes")
}

// ─────────────────────────────────────────────────────────────────────────────
// Legacy Bookings (marketplace / provider matching flow)
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id               String        @id @default(cuid())
  clientId         String
  client           User          @relation("ClientBookings", fields: [clientId], references: [id])
  providerId       String
  provider         User          @relation("ProviderBookings", fields: [providerId], references: [id])
  serviceType      String?
  status           BookingStatus @default(pending)
  scheduledAt      DateTime
  startedAt        DateTime?
  completedAt      DateTime?
  durationHours    Decimal?      @db.Decimal(5, 2)
  totalAmount      Decimal?      @db.Decimal(10, 2)
  currency         String        @default("QAR")
  notes            String?
  providerNotes    String?
  cancelReason     String?
  counterOffer     Json?
  counterOfferAt   DateTime?
  isCounterOffered Boolean       @default(false)
  noShowAt               DateTime?
  noShowPenaltyApplied   Boolean       @default(false)
  noShowPenaltyAmount    Decimal?      @db.Decimal(10, 2)
  paidWithCredits        Boolean       @default(false)
  paidAt                 DateTime?
  totalPrice             Decimal?      @db.Decimal(10, 2)
  cancellationReason     String?
  careNeedId             String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  deletedAt              DateTime?

  payment          Payment?       @relation("BookingPayment")
  disputes         BookingDispute[]
  documents        Document[]     @relation("BookingDocuments")
  review           Review?
  clientReports    ClientReport[]

  @@index([clientId])
  @@index([providerId])
  @@map("bookings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing & Invoices (M4)
// ─────────────────────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  episodeId     String?
  episode       CareEpisode?  @relation(fields: [episodeId], references: [id])
  sessionId     String?       @unique
  session       Session?      @relation(fields: [sessionId], references: [id])
  clientId      String
  client        User          @relation("ClientInvoices", fields: [clientId], references: [id])

  invoiceNumber String        @unique
  status        InvoiceStatus @default(draft)
  type          String        @default("invoice")
  currency      String        @default("QAR")
  subtotal      Decimal       @db.Decimal(10, 2)
  taxRate       Decimal       @db.Decimal(5, 4) @default(0.05)
  taxAmount     Decimal       @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  notes         String?
  dueDate       DateTime?
  sentAt        DateTime?
  paidAt        DateTime?
  pdfUrl        String?
  lineItems     Json

  payments      Payment[]     @relation("InvoicePayments")

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId])
  @@map("invoices")
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments (Stripe + Qatari Gateway)
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  bookingId       String?       @unique
  booking         Booking?      @relation("BookingPayment", fields: [bookingId], references: [id])
  invoiceId       String?
  invoice         Invoice?      @relation("InvoicePayments", fields: [invoiceId], references: [id])
  sessionId       String?       @unique
  session         Session?      @relation(fields: [sessionId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])

  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("QAR")
  status          PaymentStatus @default(pending)
  type            String        @default("charge")
  gateway         String        @default("stripe")
  gatewayRef      String?
  gatewayResponse Json?
  method          String?
  description     String?
  paidAt          DateTime?
  refundedAmount  Decimal?      @db.Decimal(10, 2)
  refundedAt      DateTime?
  metadata        Json?

  audits          PaymentAudit[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

