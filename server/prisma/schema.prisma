  hostId           String
  participantId    String
  title            String    @default("Telehealth Session")
  roomName         String    @unique
  scheduledAt      DateTime
  durationMinutes  Int       @default(60)
  status           String    @default("scheduled")
  startedAt        DateTime?
  endedAt          DateTime?
  bookingId        String?
  episodeId        String?
  notes            String?
  isRecurring      Boolean   @default(false)
  recurringPattern String?
  recordingUrl     String?
  recordingStatus  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  host             User      @relation("MeetingHost", fields: [hostId], references: [id])
  participant      User      @relation("MeetingParticipant", fields: [participantId], references: [id])

  @@map("meetings")
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId], name: "userId_lessonId")
  @@map("lesson_progress")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  passed      Boolean
  answers     Json
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model Incident {
  id                  String       @id @default(cuid())
  patientId           String
  patient             User         @relation("PatientIncidents", fields: [patientId], references: [id])
  episodeId           String?
  episode             CareEpisode? @relation("EpisodeIncidents", fields: [episodeId], references: [id])
  reportedById        String
  reportedBy          User         @relation("ReportedIncidents", fields: [reportedById], references: [id])
  assignedStaffId     String?
  assignedStaff       User?        @relation("AssignedIncidents", fields: [assignedStaffId], references: [id])
  incidentType        String
  severity            String       @default("medium")
  description         String
  location            String?
  investigationStatus String       @default("open")
  resolutionNotes     String?
  resolvedAt          DateTime?
  resolvedById        String?
  resolvedBy          User?        @relation("ResolvedIncidents", fields: [resolvedById], references: [id])
  reportedAt          DateTime     @default(now())
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([patientId])
  @@index([episodeId])
  @@map("incidents")
}

// ── GDPR / Privacy ────────────────────────────────────────────────────────────

model DataExportRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("DataExportRequests", fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("pending")
  fileUrl     String?
  requestedAt DateTime  @default(now())
  expiresAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@map("data_export_requests")
}

model AccountDeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("AccountDeletionRequests", fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("pending")
  reason      String?
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@map("account_deletion_requests")
}

// ── Push Notifications ────────────────────────────────────────────────────────

model PushNotificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("PushTokens", fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_notification_tokens")
}

