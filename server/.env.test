# ── Test environment — used by jest automatically when NODE_ENV=test ──────────
NODE_ENV=test
PORT=5001
APP_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000
ADMIN_SECRET=test-admin-secret-not-for-production

# Separate test database — keeps test data isolated from dev
DATABASE_URL="postgresql://bugmonks@localhost:5432/riayah_plus_test?schema=public"
DATABASE_TEST_URL="postgresql://bugmonks@localhost:5432/riayah_plus_test?schema=public"

# Redis — uses a separate test DB index (index 1) to avoid polluting dev data
REDIS_URL=redis://localhost:6379/1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — short-lived for tests
JWT_ACCESS_SECRET=test-access-secret-minimum-32-characters-here
JWT_REFRESH_SECRET=test-refresh-secret-minimum-32-characters-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=1

# AWS — mocked in tests; set fake values so env validation passes
AWS_ACCESS_KEY_ID=test-key
AWS_SECRET_ACCESS_KEY=test-secret
AWS_DEFAULT_REGION=me-south-1
AWS_BUCKET=test-bucket

# Mail — not sent in tests
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=test
MAIL_PASSWORD=test
MAIL_FROM_ADDRESS=test@riayahplus.com
MAIL_FROM_NAME="Riayah Plus Test"

# Stripe — use test keys or empty (StripeService is mocked in integration tests)
STRIPE_KEY=pk_test_mock
STRIPE_SECRET=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_mock

QATAR_PAYMENT_GATEWAY=paytabs
PAYTABS_PROFILE_ID=mock
PAYTABS_SERVER_KEY=mock
PAYTABS_BASE_URL=http://localhost:9999/mock-paytabs
PAYTABS_WEBHOOK_SECRET=mock

# Socket — not used in tests
PUSHER_APP_ID=mock
PUSHER_APP_KEY=mock
PUSHER_APP_SECRET=mock
PUSHER_APP_CLUSTER=eu
BROADCAST_DRIVER=log

# LiveKit — mocked
LIVEKIT_API_KEY=mock
LIVEKIT_API_SECRET=mock
LIVEKIT_URL=wss://mock.livekit.cloud

# Firebase — mocked
FIREBASE_PROJECT_ID=mock
FIREBASE_PRIVATE_KEY_ID=mock
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMOCK\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=mock@mock.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=mock

# Maps
GOOGLE_MAPS_API_KEY=mock
GPS_CHECKIN_RADIUS_METERS=200

# WhatsApp — mocked
WHATSAPP_BASE_URL=http://localhost:9999/mock-whatsapp
WHATSAPP_PHONE_ID=mock
WHATSAPP_TOKEN=mock
WHATSAPP_VERIFY_TOKEN=mock-verify
WHATSAPP_APP_SECRET=mock

# AI
GEMINI_API_KEY=mock
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=mock

# Sentry — disabled in tests
SENTRY_DSN=
SENTRY_ENVIRONMENT=test

OPEN_EXCHANGE_RATES_KEY=mock
BACKEND_URL=http://localhost:5001
